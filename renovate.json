{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>glotzerlab/renovate-config"
  ],
  "packageRules": [
    {
      "matchManagers": ["cargo"],
      "matchPackageNames": ["bevy*"],
      "groupName": "bevy"
    },
    {
      "matchManagers": ["cargo"],
      "matchPackageNames": ["rand", "chacha20"],
      "groupName": "rand"
    }
  ]
}
