{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>glotzerlab/renovate-config"
  ],
  "packageRules": [
    {
      "matchManagers": ["cargo"],
      "matchPackageNames": ["bevy*"],
      "groupName": "bevy",
      "major": {
        "dependencyDashboardApproval": true
      },
      "minor": {
        "dependencyDashboardApproval": true
      }
    },
    {
      "matchManagers": ["cargo"],
      "matchPackageNames": ["parquet*"],
      "groupName": "parquet",
      "major": {
        "dependencyDashboardApproval": true
      }
    },
    {
      "matchManagers": ["cargo"],
      "matchPackageNames": ["rand", "rand_distr", "chacha20"],
      "groupName": "rand",
      "major": {
        "dependencyDashboardApproval": true
      },
      "minor": {
        "dependencyDashboardApproval": true
      }
    },
    {
      "matchManagers": ["cargo"],
      "matchPackageNames": ["wayland-*"],
      "groupName": "wayland"
    },
    {
      "matchPackageNames": ["rust"],
      "matchCurrentVersion": "/nightly/",
      "enabled": false
    },
    {
      "matchManagers": ["cargo"],
      "matchPackageNames": ["anyhow"],
      "major": {
        "dependencyDashboardApproval": true
      }
    },
    {
      "matchManagers": ["cargo"],
      "matchPackageNames": ["approxim"],
      "major": {
        "dependencyDashboardApproval": true
      },
      "minor": {
        "dependencyDashboardApproval": true
      }
    },
    {
      "matchManagers": ["cargo"],
      "matchPackageNames": ["arrayvec"],
      "major": {
        "dependencyDashboardApproval": true
      },
      "minor": {
        "dependencyDashboardApproval": true
      }
    },
    {
      "matchManagers": ["cargo"],
      "matchPackageNames": ["log"],
      "major": {
        "dependencyDashboardApproval": true
      },
      "minor": {
        "dependencyDashboardApproval": true
      }
    },
    {
      "matchManagers": ["cargo"],
      "matchPackageNames": ["num-complex"],
      "major": {
        "dependencyDashboardApproval": true
      },
      "minor": {
        "dependencyDashboardApproval": true
      }
    },
    {
      "matchManagers": ["cargo"],
      "matchPackageNames": ["serde"],
      "major": {
        "dependencyDashboardApproval": true
      }
    }
  ]
}
